# Personal AI Workbench v2 server
PORT=4173
HOST=127.0.0.1

# Persistence. Defaults to ./data
# DATA_DIR=/absolute/path/to/persistent/data

# Project workspace. Can also be changed in Settings.
# WORKSPACE_ROOT=/absolute/path/to/your/projects

# Docker Compose settings
# WORKBENCH_BIND_ADDRESS=127.0.0.1
# WORKBENCH_PORT=4173
# WORKBENCH_DATA_PATH=./data
# WORKBENCH_WORKSPACE_PATH=/absolute/path/to/your/projects
# WORKBENCH_UID=1000
# WORKBENCH_GID=1000

WORKBENCH_PASSWORD=
SESSION_SECRET=
TRUSTED_ORIGINS=
COOKIE_SECURE=0
CAPTURE_TOKEN=

# GetNote / 得到大脑 is configured in Settings.
# Setup/update: npx -y @getnote/cli@latest setup
# Read-only check: getnote doctor -o json

# Feishu project records and Daily Work Journal use the host user's lark-cli login.

# Joycrew unified business execution (optional and fail-isolated)
# Browser code never receives these values. Workbench calls Joycrew server-to-server.
# Recommended: Joycrew runs with JOYCREW_AUTH_MODE=trusted_proxy and the same token.
JOYCREW_ENABLED=0
JOYCREW_BASE_URL=http://127.0.0.1:4000
JOYCREW_NETWORK_ZONE=local_loopback
JOYCREW_AUTH_MODE=trusted_proxy
JOYCREW_TRUSTED_PROXY_TOKEN=
# Alternative: JOYCREW_AUTH_MODE=signed_session
JOYCREW_SESSION_TOKEN=
JOYCREW_WORKSPACE_ID=ws-dongjue
JOYCREW_USER_ID=user-chris
JOYCREW_ROLE=admin
# JOYCREW_TIMEOUT_MS=20000
# JOYCREW_MAX_RESPONSE_BYTES=2000000

# In Docker, use http://host.docker.internal:4000 when Joycrew runs on the host,
# and set JOYCREW_NETWORK_ZONE=private_http.

# Rate limits
# WORKBENCH_RATE_LIMIT_WINDOW_MS=60000
# WORKBENCH_RATE_LIMIT_MAX_CLIENTS=1000
# WORKBENCH_CAPTURE_RATE_LIMIT=60
# WORKBENCH_SYNC_RATE_LIMIT=12
# WORKBENCH_MORNING_RATE_LIMIT=20
# WORKBENCH_HARNESS_RATE_LIMIT=20
# WORKBENCH_JOYCREW_RATE_LIMIT=30

# Project scan budgets
# WORKBENCH_SCAN_MAX_FILES=600
# WORKBENCH_SCAN_MAX_DIRECTORIES=400
# WORKBENCH_SCAN_MAX_DEPTH=12
# WORKBENCH_SCAN_MAX_DURATION_MS=5000

# OpenAI-compatible analysis provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_SEND_FILE_CONTENT=0

# Optional third-party provider profile
# AI_PROVIDER_PROFILE=third_party_responses
# AI_PROVIDER_ENABLED=1
# AI_PROVIDER_BASE_URL=https://gateway.example.invalid/v1
# AI_PROVIDER_ALLOWED_ORIGINS=https://gateway.example.invalid
# AI_PROVIDER_NETWORK_ZONE=public_https
# AI_PROVIDER_MODEL=approved-model-id
# AI_PROVIDER_API_KEY=
# AI_PROVIDER_GROK_MODEL=grok-4.6
# AI_PROVIDER_GROK_API_KEY=
# AI_PROVIDER_ACTIVE_MODEL=gpt-5.6-luna
# AI_PROVIDER_WORKFLOWS=project_creation,project_progress,morning_dialogue,ai_console
# AI_PROVIDER_TIMEOUT_MS=120000
# AI_PROVIDER_MAX_RESPONSE_BYTES=2000000
# AI_SEND_FILE_CONTENT=0

# DeepSeek Harness unified Copilot. Docker contains the runtime; source checkouts
# install it once with npm run harness:install.
HARNESS_ENABLED=0
# The Sidecar reuses OPENAI_/AI_PROVIDER_ by default. Explicit overrides:
# HARNESS_PROVIDER_MODEL=gpt-5.6-luna
# HARNESS_PROVIDER_API_KEY=
# HARNESS_PROVIDER_API=openai-responses
# HARNESS_PROVIDER_BASE_URL=https://api.openai.com/v1
# HARNESS_PROVIDER_NETWORK_ZONE=public_https
# HARNESS_PROVIDER_CONTEXT_WINDOW=131072
# HARNESS_PROVIDER_MAX_TOKENS=4096
# HARNESS_REQUEST_TIMEOUT_MS=180000

# Explicit emergency override; unsafe for public binding.
# ALLOW_INSECURE_PUBLIC=0

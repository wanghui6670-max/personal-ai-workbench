# Server
PORT=4173
HOST=127.0.0.1

# Persistence. Defaults to ./data
# DATA_DIR=/absolute/path/to/persistent/data

# Project workspace. Can also be changed in Settings.
# WORKSPACE_ROOT=/absolute/path/to/your/projects

# Docker Compose settings (Compose reads these directly).
# WORKBENCH_BIND_ADDRESS=127.0.0.1
# Sets both the published host port and the app's container-side PORT.
# WORKBENCH_PORT=4173
# WORKBENCH_DATA_PATH=./data
# WORKBENCH_WORKSPACE_PATH=/absolute/path/to/your/projects
# WORKBENCH_UID=1000
# WORKBENCH_GID=1000

# Optional login protection. Strongly recommended when binding beyond localhost.
WORKBENCH_PASSWORD=
# Intentionally blank. If WORKBENCH_PASSWORD is enabled, set a unique random value (24+ characters).
SESSION_SECRET=
# Comma-separated full origins for reverse proxies, LAN or Tailscale access.
TRUSTED_ORIGINS=
# Set to 1 whenever browsers reach the service over HTTPS.
COOKIE_SECURE=0

# Capture stays closed without this token or an authenticated password session.
CAPTURE_TOKEN=

# Feishu is configured in the Settings page, not by copying credentials here.
# The host must have lark-cli installed and the current user logged in.

# Expensive endpoint limits are per client and per fixed window.
# Values above the built-in safety caps are clamped.
# WORKBENCH_RATE_LIMIT_WINDOW_MS=60000
# WORKBENCH_RATE_LIMIT_MAX_CLIENTS=1000
# WORKBENCH_CAPTURE_RATE_LIMIT=60
# WORKBENCH_SYNC_RATE_LIMIT=12
# WORKBENCH_MORNING_RATE_LIMIT=20

# Project directory scan safety budgets.
# WORKBENCH_SCAN_MAX_FILES=600
# WORKBENCH_SCAN_MAX_DIRECTORIES=400
# WORKBENCH_SCAN_MAX_DEPTH=12
# WORKBENCH_SCAN_MAX_DURATION_MS=5000

# OpenAI (optional; app has local fallback rules when unset or unavailable)
OPENAI_API_KEY=
# Default analysis model. Reasoning effort is fixed to xhigh in the app.
OPENAI_MODEL=gpt-5.6-luna
# OPENAI_SEND_FILE_CONTENT=0

# Explicit emergency override; unsafe for public binding.
# ALLOW_INSECURE_PUBLIC=0

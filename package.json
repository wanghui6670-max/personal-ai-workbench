{
  "name": "personal-ai-workbench",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "description": "Local-first AI project management workbench with human-in-the-loop scheduling.",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "NODE_ENV=development node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:files": "node scripts/test-by-file.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "migrate:project-records": "node scripts/migrate-project-records.mjs",
    "harness:install": "npm install --prefix harness --ignore-scripts --no-audit --no-fund",
    "harness:check": "node scripts/harness-check.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}

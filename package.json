{
  "name": "personal-ai-workbench",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Unified AI workbench for personal execution, Joycrew digital employees, evidence, approvals and delivery.",
  "scripts": {
    "start": "node src/server.mjs",
    "dev": "NODE_ENV=development node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:files": "node scripts/test-by-file.mjs",
    "doctor": "node scripts/doctor.mjs",
    "backup": "node scripts/backup.mjs",
    "restore": "node scripts/restore.mjs",
    "migrate:project-records": "node scripts/migrate-project-records.mjs",
    "harness:install": "npm ci --prefix harness --ignore-scripts --no-audit --no-fund",
    "harness:check": "node scripts/harness-check.mjs",
    "harness:e2e": "node scripts/harness-e2e.mjs",
    "verify": "npm run test:files && npm run harness:check && npm run harness:e2e"
  },
  "engines": {
    "node": ">=24"
  }
}
